{
  "name": "opendiag",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/app/tsconfig.json",
    "cli": "node packages/cli/src/main.ts",
    "lab": "node packages/lab/src/cli.ts",
    "app:dev": "pnpm --filter @opendiag/app dev",
    "app:build": "pnpm --filter @opendiag/app build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
